__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.coverage
htmlcov/
.env
.env.*

# Node-local plant: chat, handoffs, plans, checks, drafts, evidence, and services.
# Promote reusable behavior deliberately into tracked source and instructions.
# The whole `.mishe-*` namespace is plant-local: a typo'd `--home` or a stray
# evidence write (e.g. `.mishe-tauftauft/`) can never be staged or committed.
.mishe-*
# Settlement notes: `seed yield --file NOTES` resolves cwd-relative (plant root).
NOTES
node_modules/
artifacts/

# Local operating records and site-specific experiments stay out of Git.
AGENTS.md
research/*
!research/field-review
!research/field-review/**
!research/body/
research/body/*
!research/body/clock_bound.py
!research/body/personal-multibody.py
coordination/OPERATOR-TOPOLOGY-*.md
checks/exit-node-egress.py
tests/test_exit_node_egress.py
tools/note3-egress-ip.go
docs/agent-step-experiments.md
docs/decision-models.md
docs/how-it-works.md
docs/operating.md
docs/recovery.md
docs/superpowers/
research/field-review/__pycache__/
.claude/

# Stray repo-root pub wall output; walls belong in the gitignored site (.mishe-tauftauf/walls). Keeps substrate-watch from counting it as checkout change.
/pub/

# Mind-local scratch that lands in the checkout root but belongs in the gitignored site
# (doctrine: notes, experiments and runtime snapshots never commit). Left untracked, each
# one is re-stamped as `dirty_end` in every wake's work record, so every receipt reads as
# if that wake dirtied the tree (2026-11-17: operator wake wake-operator-1794888664164281312
# listed `.qwen/settings.local.json` and four `experiments/` files it never touched).
# `/operator/` is a stray draft copy of site plans and unit files; the live tree is
# `.mishe-tauftauf/operator/`.
/experiments/
/.qwen/
/operator/

# Test scratch: a bare `env PYTHONPATH=src .venv/bin/pytest -q` in the checkout
# root (the documented HEAD test command, see conftest.py) leaves pytest's
# default tmp base `pytest-of-<user>/` there. It is regenerable output no one
# commits, but as an untracked entry it reads as authorship fog and holds
# sense.repo.landing-block at drift. Keep it out of the checkout's status.
/pytest-of-*/

# Cargo build output of the Rust components (tools/install-rust-binaries.sh).
rust/*/target/

# Analyses and findings live under SITE_HOME/analysis; the repo is public and they may hold household-derived numbers (operator decision 2026-11-19)
/analysis/
